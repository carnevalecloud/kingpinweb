+/* The Kingpin view weapon is several models sharing one set of frames, named
+ * ..._0.mdx upwards. Draws those after the first. */
+static void
+KP_AddViewWeaponParts(entity_t *gun, const char *first)
+{
+	char name[MAX_QPATH];
+	size_t digit;
+	int part, i;
+
+	if (strncmp(first, "models/kpweb/view/", 18) || strlen(first) >= sizeof(name))
+	{
+		return;
+	}
+
+	Q_strlcpy(name, first, sizeof(name));
+	digit = strlen(name) - strlen("0.mdx");
+
+	for (part = 1; part <= 9; part++)
+	{
+		name[digit] = '0' + part;
+
+		for (i = 1; i < MAX_MODELS; i++)
+		{
+			if (!strcmp(cl.configstrings[CS_MODELS + i], name))
+			{
+				if (cl.model_draw[i])
+				{
+					gun->model = cl.model_draw[i];
+					V_AddEntity(gun);
+				}
+
+				break;
+			}
+		}
+	}
+}
+

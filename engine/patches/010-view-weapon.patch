+/* Strikes whatever is just in front of the player. Reach and strength are
+ * provisional. */
+static void
+Weapon_Pipe_Fire(edict_t *ent)
+{
+	vec3_t start, end, forward;
+	trace_t tr;
+
+	if (!ent)
+	{
+		return;
+	}
+
+	VectorCopy(ent->s.origin, start);
+	start[2] += ent->viewheight;
+	AngleVectors(ent->client->v_angle, forward, NULL, NULL);
+	VectorMA(start, 64, forward, end);
+	tr = gi.trace(start, NULL, NULL, end, ent, MASK_SHOT);
+
+	if (tr.fraction < 1.0f && tr.ent && tr.ent->takedamage)
+	{
+		T_Damage(tr.ent, ent, ent, forward, tr.endpos, tr.plane.normal,
+				15, 50, 0, MOD_HIT);
+	}
+
+	ent->client->ps.gunframe++;
+}
+
+void
+Weapon_Pipe(edict_t *ent)
+{
+	static int pause_frames[] = {0};
+	static int fire_frames[] = {7, 0};
+
+	if (!ent)
+	{
+		return;
+	}
+
+	Weapon_Generic(ent, 5, 9, 10, 15, pause_frames,
+			fire_frames, Weapon_Pipe_Fire);
+}

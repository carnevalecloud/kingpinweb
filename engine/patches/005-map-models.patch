diff --git a/src/game/g_spawn.c b/src/game/g_spawn.c
index 4214a78..be0823b 100644
--- a/src/game/g_spawn.c
+++ b/src/game/g_spawn.c
@@ -101,17 +101,66 @@ void SP_path_corner(edict_t *self);
 void SP_point_combat(edict_t *self);
 
 void SP_misc_explobox(edict_t *self);
+/* spawnflags set by src/kingpin/map-props.ts */
+#define KP_DROP_CAST 1
+#define KP_MAP_LIT 2
+#define KP_ANIMATE 4
+#define KP_DROP_ITEM 8
+
+/* Runs after brush entities have linked: drop onto the floor, then cycle the
+ * idle frames if requested. */
+static void KP_StaticThink(edict_t *ent)
+{
+	if (ent->spawnflags & (KP_DROP_CAST | KP_DROP_ITEM))
+	{
+		vec3_t mins = {-16, -16, -16}, maxs = {16, 16, 16}, start, end;
+		trace_t tr;
+
+		if (ent->spawnflags & KP_DROP_CAST)
+		{
+			mins[2] = -24;
+			maxs[2] = 48;
+		}
+		VectorCopy(ent->s.origin, start);
+		VectorCopy(ent->s.origin, end);
+		start[2] += 1;
+		end[2] -= 256;
+		tr = gi.trace(start, mins, maxs, end, ent, MASK_SOLID);
+		/* Keep the authored position when the box does not fit or finds no floor. */
+		if (!tr.startsolid && !tr.allsolid && tr.fraction < 1.0f)
+		{
+			VectorCopy(tr.endpos, ent->s.origin);
+			VectorCopy(tr.endpos, ent->s.old_origin);
+			gi.linkentity(ent);
+		}
+		ent->spawnflags &= ~(KP_DROP_CAST | KP_DROP_ITEM);
+	}
+	if ((ent->spawnflags & KP_ANIMATE) && ent->count > 1)
+	{
+		ent->s.frame = (ent->s.frame + 1) % ent->count;
+		ent->nextthink = level.time + FRAMETIME;
+	}
+}
+
 static void KP_StaticModel(edict_t *ent)
 {
 	if (!ent->model || !ent->model[0]) { G_FreeEdict(ent); return; }
 	ent->movetype = MOVETYPE_NONE;
 	ent->solid = SOLID_NOT;
 	ent->s.modelindex = gi.modelindex(ent->model);
-	ent->s.renderfx |= RF_FULLBRIGHT;
+	if (!(ent->spawnflags & KP_MAP_LIT))
+	{
+		ent->s.renderfx |= RF_FULLBRIGHT;
+	}
 	ent->s.skinnum = ent->style >= 0 && ent->style < 32 ? ent->style : 0;
 	VectorSet(ent->mins, -32, -32, -32);
 	VectorSet(ent->maxs, 32, 32, 64);
-	gi.dprintf("KP static model: %s index %d\n", ent->model, ent->s.modelindex);
+	if (ent->spawnflags & (KP_DROP_CAST | KP_ANIMATE | KP_DROP_ITEM))
+	{
+		ent->think = KP_StaticThink;
+		ent->nextthink = level.time + 2 * FRAMETIME;
+	}
+	gi.dprintf("KP static model: %s index %d at %s\n", ent->model, ent->s.modelindex, vtos(ent->s.origin));
 	gi.linkentity(ent);
 }
 
